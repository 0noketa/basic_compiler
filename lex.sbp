#ifndef lex__sbp
#define lex__sbp

#include "libc.sbp"
#include "file.sbp"

Function IsNam(c As Long) As Long
	IsNam= _
		( (Asc("A")<=c) And (c<=Asc("Z")) ) Or _
		( (Asc("a")<=c) And (c<=Asc("z")) )
End Function

Function IsNum(c As Long) As Long
	IsNum= _
		(Asc("0")<=c) And (c<=Asc("9"))
End Function

Function IsNamOrNum(c As Long) As Long
	IsNamOrNum= IsNam(c) Or IsNum(c)
End Function

Function IsNotAny(c As Long) As Long
	IsNotAny= FALSE
End Function

Function IsQrt(c As Long) As Long
	IsQrt= (c = Asc(Ex"\q"))
End Function

Function IsNotQrt(c As Long) As Long
	IsNotQrt= (c <> Asc(Ex"\q"))
End Function

Class SrcFile: Inherits OFile
	Protected
		current_token As String
		current_line As String
		qt_pos As Long

	Public
		Sub SrcFile( name As String )
			OFile(name, "r")
			current_token= ""
			current_line= ReadLn()
		End Sub

		Function AtEol() As Long
			AtEol= (current_line="")
		End Function

		Sub NextLine()
			current_line= ReadLn()

			TrimLeft(current_line)
			qt_pos= InStr(1, current_line, Ex"\q")
			If qt_pos=0 Then  qt_pos= Len(current_line)
		End Sub

		Function ReadToken() As String
			Dim i As Long
			Dim l As Long
			' Dim f As *Function(param_c As Long) As Long
			Dim sizeOfLastNoise As Long
			Dim c As Long
			TrimLeft(current_line)

			If (AtEof()) Or (AtEol()) Then
				ReadToken = ""
				current_token = ReadToken
				Exit Function
			End If

			l= Len(current_line)
			c= Asc(Mid$(current_line, 1,1))
			sizeOfLastNoise= 0

			' inline
			If IsNam(c) Then
				i= 1
				c= Asc(Mid$(current_line, 1,1))
				Do
					i += 1
					If l<i Then
						sizeOfLastNoise= 0
						Exit Do
					End If
					c = Asc(Mid$(current_line, i,1))
				Loop While IsNamOrNum(c)
			ElseIf IsNum(c) Then
				i= 1
				c= Asc(Mid$(current_line, 1,1))
				Do
					i += 1
					If l<i Then
						sizeOfLastNoise= 0
						Exit Do
					End If
					c = Asc(Mid$(current_line, i,1))
				Loop While IsNum(c)
			ElseIf IsQrt(c) Then
				sizeOfLastNoise= 1
				i= 1
				c= Asc(Mid$(current_line, 1,1))
				Do
					i += 1
					If l<i Then
						sizeOfLastNoise= 0
						Exit Do
					End If
					c = Asc(Mid$(current_line, i,1))
				Loop While IsNotQrt(c)
			Else
				i= 1
				c= Asc(Mid$(current_line, 1,1))
				Do
					i += 1
					If l<i Then
						sizeOfLastNoise= 0
						Exit Do
					End If
					c = Asc(Mid$(current_line, i,1))
				Loop While IsNotAny(c)
			End If

			' // func ptr seems broken
			' If IsNam(c) Then
			' 	f = AddressOf(IsNamOrNum)
			' ElseIf IsNum(c) Then
			' 	f = AddressOf(IsNum)
			' ElseIf IsQrt(c) Then
			' 	f = AddressOf(IsNotQrt)
			' 	sizeOfLastNoise= 1
			' Else
			' 	f = AddressOf(IsNotAny)
			' End If

			' i= 1
			' c= Asc(Mid$(current_line, 1,1))
			' Do
			' 	i += 1
			' 	If l<i Then
			' 		sizeOfLastNoise= 0
			' 		Exit Do
			' 	End If
			' 	c = Asc(Mid$(current_line, i,1))
			' Loop While f(c)

			i += sizeOfLastNoise

			ReadToken = Left$(current_line, i - 1)
			current_line = Right$(current_line, l - (i - 1))
			current_token = ReadToken
		End Function

		Sub UnReadToken()
			current_line= current_token+" "+current_line
			current_token=""
		End Sub

		Sub TrimLeft(ByRef s As String)
			Dim i As Long
			Dim l As Long
			i= 1
			l= Len(s)
			While i<=l
				If InStr(1, Ex" \t\r\n", Mid$(s, i,1))=0 Then _
					Exit While
				i+= 1
			Wend

			s= Mid$(s, i)
		End Sub
End Class


#endif
