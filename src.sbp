#ifndef src__sbp
#define src__sbp


#include "lex.sbp"
#include "expr.sbp"


Const max_vars_count = 256

Function UpperStr(s As String) As String
	Dim c As String
	Dim s2 As String
	Dim i As Long
	Dim j As Long

	s2 = ""
	j = 1
	For i = 1 To Len(s)
		s2 = s2 + Chr$(C_toupper(Asc(Mid$(s, i, 1))))
	Next

	UpperStr = s2
End Function

Class VarInfo
	Protected
		_name As String
		_is_proc As Long
		_type As String
		_param_type As String
		_size As Long
		_lbound As Long
		_attr As String
	Public
		Function GetName() As String
			GetName = _name
		End Function
		Sub SetName(s As String)
			_name = s
		End Sub
		Function GetIsProc() As Long
			GetIsProc = _is_proc
		End Function
		Sub SetIsProc(n As Long)
			_is_proc = n
		End Sub
		Function GetType() As String
			GetType = _type
		End Function
		Sub SetType(s As String)
			_type = s
		End Sub
		Function GetParamType() As String
			GetParamType = _param_type
		End Function
		Sub SetParamType(s As String)
			_param_type = s
		End Sub
		Function GetSize() As Long
			GetSize = _size
		End Function
		Sub SetSize(s As Long)
			_size = s
		End Sub
		Function GetLBound() As Long
			GetLBound = _lbound
		End Function
		Sub SetLBound(s As Long)
			_lbound = s
		End Sub
		Function GetAttr() As String
			GetAttr = _attr
		End Function
		Sub SetAttr(s As String)
			_attr = s
		End Sub
End Class

Class VarDict
	Protected
		_varinfos As **VarInfo
		_len As Long
	Public
		Sub VarDict()
			Dim i As Long

			_varinfos = malloc(SizeOf(*VarInfo) * max_vars_count)
			For i = 0 To max_vars_count - 1
				_varinfos[i] = New VarInfo
			Next
			_len = 0
		End Sub
		Sub ~VarDict()
			Dim i As Long

			For i = 0 To max_vars_count - 1
				Delete _varinfos[i]
			Next
			free(_varinfos)
		End Sub
		Function Count() As Long
			Count = _len
		End Function
		Function GetVarName(_idx As Long) As String
			If (_idx < 0) Or (_idx >= _len) Then
				GetVarName = ""
				Exit Function
			End If
			' AB4 parser can not accept below. maybe "_" often be incorrect char,
			' because whit expression with id "argv" works. 
			'   GetVarName = _varinfos[_idx]->GetName()
			Dim info As *VarInfo : info = _varinfos[_idx]
			GetVarName = info->GetName()
		End Function
		Function GetVarIndex(_name As String) As Long
			Dim i As Long
			Dim _name2 As String
			Dim info As *VarInfo

			_name2 = UpperStr(_name)
			i = 0
			While i < _len
				info = _varinfos[i]
				If UpperStr(info->GetName()) = _name2 Then
					GetVarIndex = i
					Exit Function
				End If

				i += 1
			Wend

			GetVarIndex = -1
		End Function
		Function CorrectVarName(_name As String) As String
			CorrectVarName = GetVarName(GetVarIndex(_name))
		End Function
		Function IsVarOrProc(_name As String) As Long
			IsVarOrProc = (GetVarIndex(_name) <> -1)
		End Function
		Function IsProc(_name As String) As Long
			Dim i As Long : i = GetVarIndex(_name)
			If i = -1 Then
				IsProc = (0<>0)
				Exit Function
			End If

			Dim info As *VarInfo : info = _varinfos[i] 
			IsProc = info->GetIsProc()
		End Function
		Function IsVar(_name As String) As Long
			Dim i As Long : i = GetVarIndex(_name)
			If i = -1 Then
				IsVar = (0<>0)
				Exit Function
			End If

			Dim info As *VarInfo : info = _varinfos[i] 
			IsVar = (Not info->GetIsProc())
		End Function
		Function GetArrayLBound(_name As String) As Long
			Dim i As Long : i = GetVarIndex(_name)
			If i = -1 Then
				GetArrayLBound = -1
				Exit Function
			End If

			Dim info As *VarInfo : info = _varinfos[i]
			GetArrayLBound = info->GetLBound()
		End Function
		Function GetArrayLength(_name As String) As Long
			Dim i As Long : i = GetVarIndex(_name)
			If i = -1 Then
				GetArrayLength = -1
				Exit Function
			End If

			Dim info As *VarInfo : info = _varinfos[i]
			GetArrayLength = info->GetSize()
		End Function
		Function IsArray(_name As String) As Long
			IsArray = (GetArrayLength(_name) <> -1)
		End Function
		Function IsExtern(_name As String) As Long
			Dim i As Long : i = GetVarIndex(_name)
			If i = -1 Then
				IsExtern = (0 <> 0)
				Exit Function
			End If

			Dim info As *VarInfo : info = _varinfos[i]
			IsExtern = (InStr(1, info->GetAttr(), "e") <> 0)
		End Function
		Function GetParamType(_name As String) As String
			Dim i As Long : i = GetVarIndex(_name)
			If i = -1 Then
				GetParamType = "error_type"
				Exit Function
			End If

			Dim info As *VarInfo : info = _varinfos[i]
			GetParamType = info->GetParamType()
		End Function
		Function GetResultType(_name As String) As String
			Dim i As Long : i = GetVarIndex(_name)
			If i = -1 Then
				GetResultType = "error_type"
				Exit Function
			End If

			Dim info As *VarInfo : info = _varinfos[i]
			GetResultType = info->GetType()
		End Function
		Sub AddProc(_name As String, _arg_type As String, _type As String, _attr As String)
			If IsVar(_name) Then  Exit Sub

			Dim info As *VarInfo
			If _len < max_vars_count Then
				info = _varinfos[_len]
				info->SetName(_name)
				info->SetIsProc((0=0))
				info->SetParamType(_arg_type)
				info->SetType(_type)
				info->SetSize(1)
				info->SetLBound(0)
				info->SetAttr(_attr)

				_len += 1
			End If
		End Sub
		Sub AddVar(_name As String, _type As String, _size As Long, _lbound As Long, _attr As String)
			If IsVar(_name) Then  Exit Sub

			Dim info As *VarInfo
			If _len < max_vars_count Then
				info = _varinfos[_len]
				info->SetName(_name)
				info->SetIsProc((0<>0))
				info->SetParamType("")
				info->SetType(_type)
				info->SetSize(_size)
				info->SetLBound(_lbound)
				info->SetAttr(_attr)

				_len += 1
			End If
		End Sub

		Sub AddVoidProc(_name As String)
			AddProc(_name, "", "", "")
		End Sub
		Sub AddIntProc(_name As String)
			AddProc(_name, "Integer", "", "")
		End Sub
		Sub AddNullaryIntFunc(_name As String)
			AddProc(_name, "", "Integer", "")
		End Sub
		Sub AddIntFunc(_name As String)
			AddProc(_name, "Integer", "Integer", "")
		End Sub
		Sub AddIntVar(_name As String)
			AddVar(_name, "Integer", -1, 0, "")
		End Sub
		Sub AddIntArray(_name As String, _len As Long, _lbound As Long)
			AddVar(_name, "Integer", _len, _lbound, "")
		End Sub

		Sub AddExternVoidProc(_name As String)
			AddProc(_name, "", "", "e")
		End Sub
		Sub AddExternIntProc(_name As String)
			AddProc(_name, "Integer", "", "e")
		End Sub
		Sub AddExternNullaryIntFunc(_name As String)
			AddProc(_name, "", "Integer", "e")
		End Sub
		Sub AddExternIntFunc(_name As String)
			AddProc(_name, "Integer", "Integer", "e")
		End Sub
		Sub AddExternIntVar(_name As String)
			AddVar(_name, "Integer", -1, 0, "e")
		End Sub
End Class



Dim vars As VarDict

Function VarsCount() As Long
	VarsCount = vars.Count()
End Function

Function IsVar(s As String) As Long
	IsVar = vars.IsVar(s)
End Function
Function IsProc(s As String) As Long
	IsProc = vars.IsProc(s)
End Function

Sub AddIntVar(s As String)
	If vars.IsVarOrProc(s) Then  Exit Sub

	vars.AddIntVar(s)
End Sub

Sub AddExternIntFunc(s As String)
	If vars.IsVarOrProc(s) Then  Exit Sub

	vars.AddExternIntFunc(s)
End Sub
Sub AddExternNullaryIntFunc(s As String)
	If vars.IsVarOrProc(s) Then  Exit Sub

	vars.AddExternIntFunc(s)
End Sub
Sub AddExternIntVar(s As String)
	If vars.IsVarOrProc(s) Then  Exit Sub

	vars.AddExternIntVar(s)
End Sub

Sub AddIntArray(s As String, _len As Long, _lbound As Long)
	If vars.IsVarOrProc(s) Then  Exit Sub

	vars.AddIntArray(s, _len, _lbound)
End Sub

Function UseVar(s As String) As String
	Dim result As String : result = s

	If IsVar(s) Then
		UseVar = vars.CorrectVarName(s)
		Exit Function
	End If

	AddIntVar(s)

	UseVar = result
End Function




Class BasicSrc
	Inherits SrcFile

	Protected
		lines_nums As *Long
		lines As *Expr
		lines_count As Long

	Public
		Sub BasicSrc( name As String )
			SrcFile(name)

			current_token= ""
			lines_nums = NULL
			lines = NULL
		End Sub

		Sub ~BasicSrc()
			If lines <> NULL Then free(lines)
			If lines_nums <> NULL Then free(lines_nums)
		End Sub

		Sub loadArgs( e As *Expr )
			Dim s As String

			If ReadToken() = ")" Then  Exit Sub
	
			UnReadToken()
	
			Do
				e->AddArg( compileExpr() )
				s = ReadToken()
			Loop While s = ","

			If s <> ")" Then  UnReadToken()
		End Sub

		Function compileVal() As *Expr
			Dim e As *Expr
			Dim s As String
			Dim s2 As String

			s= ReadToken()
			If s="(" Then
				e= compileExpr()
				ReadToken()
			ElseIf IsNum(Asc(Mid$(s, 1,1))) Then
				e= New Expr()
				e->SetOpr("val")
				e->SetVal(s)
			ElseIf IsNam(Asc(Mid$(s, 1,1))) Then
				s2 = ReadToken()
				If s2 = "(" Then
					e= New Expr()
					e->SetOpr("apply")
					e->SetVal(s)

					If ReadToken() <> ")" Then
						UnReadToken()
						e->AddArg(compileExpr())
						ReadToken()
					End If
				Else
					UnReadToken()
					e= New Expr()
					e->SetOpr("val")
					e->SetVal(UseVar(s))
				End If
			Else
				UnReadToken()
				e= NULL
			End If

			compileVal = e
		End Function

		Function compileExprMul() As *Expr
			Dim r As *Expr
			Dim e As *Expr
			Dim s As String

			r= compileVal()
			While TRUE
				s= ReadToken()
				If (s="*") Or (s="/") Or (s="MOD") Then
					e= New Expr()
					e->SetOpr(s)
					e->AddArg( r )
					e->AddArg( compileVal() )
					r= e
				Else
					If s<>"" Then  UnReadToken()

					compileExprMul = r
					Exit Function
				End If
			Wend
		End Function
		Function compileExprAdd() As *Expr
			Dim r As *Expr
			Dim e As *Expr
			Dim s As String

			r= compileExprMul()
			While TRUE
				s= ReadToken()
				If (s="+") Or (s="-") Then
					e= New Expr()
					e->SetOpr(s)
					e->AddArg( r )
					e->AddArg( compileExprMul() )
					r= e
				Else
					If s<>"" Then  UnReadToken()

					compileExprAdd = r
					Exit While
				End If
			Wend
		End Function
		Function compileExprCmp() As *Expr
			Dim r As *Expr
			Dim e As *Expr
			Dim s As String

			r= compileExprAdd()
			While TRUE
				s= ReadToken()
				If (s="<") Or (s=">") Or (s="=") Then
					e= New Expr()
					e->SetOpr(s)
					e->AddArg( r )
					e->AddArg( compileExprAdd() )
					r= e
				Else
					If s<>"" Then  UnReadToken()

					compileExprCmp = r
					Exit Function
				End If
			Wend
		End Function

		Function compileExpr() As *Expr
			compileExpr = compileExprCmp()
		End Function

		Function InferExprType(e As *Expr, update As Long) As String
			Dim left_type As String
			Dim right_type As String
			Dim result As String
			Dim _val As String

			_val = e->GetVal()
			result = e->GetType()
			If e->OprIs("val") Then
				If IsNum(Asc(Mid$(_val, 1,1))) Then
					result = "Integer"
				ElseIf Mid$(_val, 1,1) = Chr$(34)  Then
					result = "String"
				ElseIf IsVar(_val) Then
					result = "Integer"
				End If
			ElseIf e->OprIs("+") Then
				If e->GetArgc() = 2 Then
					left_type = InferExprType(e->GetArgv(0), update)
					right_type = InferExprType(e->GetArgv(1), update)
					result = left_type
				End If
			ElseIf e->OprIs("-") Or  e->OprIs("*") Or e->OprIs("/") Or e->OprIs("MOD") Then
				If e->GetArgc() = 2 Then
					left_type = InferExprType(e->GetArgv(0), update)
					right_type = InferExprType(e->GetArgv(1), update)

					If left_type <> right_type Then
						result = "ErrorType"
					Else
						result = left_type
					End If
				End If
			End If

			If update <> 0 Then  e->SetType(result)

			InferExprType = result
		End Function

End Class


#endif

